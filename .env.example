# คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env ไม่ถูก commit)
# ใช้โดย docker-compose.yml; เซิร์ฟเวอร์ Go อ่านจากตัวแปรสภาพแวดล้อมเหมือนกัน (ดู server/README.md)

# --- ฐานข้อมูล (container catquest-db) ---
POSTGRES_USER=catquest
POSTGRES_PASSWORD=catquest_dev_password   # ⚠️ เปลี่ยนเมื่อใช้งานจริง
POSTGRES_DB=catquest
DB_PORT=5433                              # พอร์ตฝั่งเครื่อง (5432 มักถูก Postgres ตัวอื่นใช้อยู่)

# --- เซิร์ฟเวอร์เกม (เมื่อรันด้วย `docker compose --profile app up`) ---
SERVER_PORT=8080
APP_ENV=development                       # production = เข้มงวดขึ้น (ต้องตั้ง DATABASE_URL/ALLOWED_ORIGINS/COOKIE_SECURE เอง)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false                       # ต้องเป็น true เมื่อเว็บใช้ HTTPS
FIRST_USER_IS_ADMIN=true                  # ผู้ใช้คนแรกที่สมัครได้เป็น admin (ปิดเมื่อใช้งานจริงแล้ว)
